#   . /home/common/profile_synopsys
#   SYN_PROFILE=gemv SYN_TOP=gemv_unit SYN_TAG=gemv_attacc #     SYN_PERIOD_NS=1.5015015 dc_shell -f run_dc_asap7_0830-02.tcl
